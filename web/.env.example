# --- Email capture (the launch list) ---
# The /api/subscribe route works WITHOUT these (it logs signups), so the form is
# functional in dev and soft-launch. Set both before going public to push
# contacts into a Resend audience. Swap for Substack/Beehiiv if preferred.

# https://resend.com → API Keys
RESEND_API_KEY=

# https://resend.com → Audiences → (your audience) → copy the ID
RESEND_AUDIENCE_ID=
