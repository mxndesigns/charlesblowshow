# --- Email capture (the launch list) ---
# The /api/subscribe route works WITHOUT these (it logs signups), so the form is
# functional in dev and soft-launch. Set both before going public to push
# contacts into a Resend audience. Swap for Substack/Beehiiv if preferred.

# https://resend.com → API Keys
RESEND_API_KEY=

# https://resend.com → Audiences → (your audience) → copy the ID
RESEND_AUDIENCE_ID=


# --- Dashboard / CMS console auth (the /dashboard route group) ---
# Single-seat login (plan §2). The console runs out of the box on dev defaults;
# CHANGE BOTH before any deploy. DASHBOARD_PASSWORD is what you type at /login;
# DASHBOARD_SESSION_SECRET is the opaque value stored in the session cookie.
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=


# --- Subscriber integrations (Overview tiles + revenue forecast) ---
# Every tile works via manual entry; set these to override with real numbers.
# YouTube can go fully live with a Google API key + channel id.

# https://console.cloud.google.com → enable "YouTube Data API v3" → create key
YOUTUBE_API_KEY=
# The channel id (starts with UC...). YouTube Studio → Settings → Channel → Advanced
YOUTUBE_CHANNEL_ID=

# Manual fallbacks — update any time, no deploy needed (Substack/LinkedIn have no
# clean API, so they stay manual; Instagram needs a Business account + app review).
MANUAL_YOUTUBE_SUBSCRIBERS=
MANUAL_INSTAGRAM_SUBSCRIBERS=
MANUAL_SUBSTACK_SUBSCRIBERS=
MANUAL_LINKEDIN_SUBSCRIBERS=
